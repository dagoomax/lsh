      "parameters": {
        "jsCode": "// hotel.checkout → housekeeping turnover task.\nconst b = $input.first().json.body || {};\nconst d = b.data || {};\nconst at = new Date(d.at || Date.now());\nconst summary = '🧹 Turnover: room ' + d.room + ' vacated ' + at.toLocaleString() + (d.guest ? ' (was ' + d.guest + ')' : '') + ' — schedule cleaning & inspection.';\nreturn [{ json: { event: b.event, room: d.room, vacatedAt: at.toISOString(), status: 'needs-cleaning', priority: 'normal', summary } }];"
