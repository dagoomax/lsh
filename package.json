{
  "name": "victron-dashboard",
  "version": "1.32.0",
  "description": "Lightweight Smart Home — Node.js smart-home hub integrating ~40 platforms, with relay control and HomeKit integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs lsh",
    "pm2:status": "pm2 status",
    "openapi": "node scripts/gen-openapi.js"
  },
  "overrides": {
    "protobufjs": "^7.6.4",
    "qs": "6.16.0",
    "binary-parser": "2.3.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "acme-client": "^5.4.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.0",
    "hap-nodejs": "^0.12.2",
    "jsonwebtoken": "^9.0.3",
    "jssip": "^3.13.8",
    "mongodb": "^7.5.0",
    "mqtt": "^4.1.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "socket.io-parser": "^4.2.7"
  },
  "devDependencies": {
    "swagger-ui-dist": "^5.17.14"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "optionalDependencies": {
    "@tensorflow/tfjs-node": "^4.22.0"
  }
}
