    "@lox-audioserver/node-airplay-sender": "^0.4.10",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "acme-client": "^5.4.0",
    "bcryptjs": "^3.0.3",
    "bonjour-service": "^1.4.4",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.0",
    "hap-nodejs": "^0.12.2",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.3",
    "jssip": "^3.13.8",
