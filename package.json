{
  "name": "victron-dashboard",
  "version": "1.12.0",
  "description": "Lightweight Smart Home — Node.js smart-home hub integrating ~40 platforms, with relay control and HomeKit integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs lsh",
    "pm2:status": "pm2 status",
    "openapi": "node scripts/gen-openapi.js"
  },
  "overrides": {
    "protobufjs": "^7.6.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@foxxmd/chromecast-client": "^1.0.4",
