+func newRecordingsCmd() *cobra.Command {
+	cmd := &cobra.Command{
+		Use:   "recordings [device-id|name] [YYYY-MM-DD]",
+		Short: "List a day's SD-card recordings",
+		Long: `List the SD-card recording segments of one day. Each segment can be played
