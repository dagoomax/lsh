+// QueryRecordsByDay lists a day's SD-card recordings on a connected replay session.
+func (c *MQTTCameraClient) QueryRecordsByDay(year, month, day int) ([]SDRecord, error) {
+	c.recordPages = make(chan RecordQueryFrame, 64)
+
+	err := c.sendMqttMessage("recordQueryByDay", 312, utils.RandString(32, 16), RecordQueryRequest{
+		Mode:    "webrtc",
+		PageId:  -1,
+		Channel: 0,
+		Event:   "all",
+		Year:    year,
+		Month:   month,
+		Day:     day,
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	// Pages (10 files each) arrive out of order and some never arrive at all —
+	// collect until every page is in, or the camera goes quiet for 3 s.
+	pages := map[int][]SDRecord{}
+	collected := func() []SDRecord {
+		records := []SDRecord{}
+		for _, files := range pages {
+			records = append(records, files...)
+		}
+		sort.Slice(records, func(i, j int) bool { return records[i].StartTime < records[j].StartTime })
+		return records
+	}
+
+	timeout := time.After(30 * time.Second)
+	var idle <-chan time.Time
+	totalPages := 0
+	for {
+		select {
+		case page := <-c.recordPages:
+			switch page.ResCode {
+			case 0:
+				pages[page.PageId] = page.Files
+				totalPages = page.TotalPageNum
+				if len(pages) >= totalPages {
+					return collected(), nil
+				}
+				idle = time.After(3 * time.Second)
+			case -4:
+				return nil, errors.New("camera does not support SD-card playback")
+			default:
+				return nil, fmt.Errorf("record query failed: resCode %d", page.ResCode)
+			}
+		case <-idle:
+			core.Logger.Warn().Msgf("recordQueryByDay: got %d of %d page(s)", len(pages), totalPages)
+			return collected(), nil
+		case <-timeout:
+			return nil, errors.New("record query timed out")
+		}
+	}
+}
+
+// SendPlaybackStart starts SD-card playback of [startTime, endTime] at playTime.
+func (c *MQTTCameraClient) SendPlaybackStart(startTime, endTime, playTime int64) error {
+	return c.sendMqttMessage("playbackStart", 312, utils.RandString(32, 16), PlaybackStartFrame{
+		Mode:            "webrtc",
+		Operation:       "start",
+		StartTime:       startTime,
+		EndTime:         endTime,
+		PlayTime:        playTime,
+		WebrtcSessionId: c.SessionId,
+	})
+}
+
+func (c *MQTTCameraClient) onMqttRecordQuery(msg *MqttMessage) {
+	core.Logger.Debug().Msgf("recordQueryByDay: %s", string(msg.Data.Message))
+
+	var frame RecordQueryFrame
+	if err := json.Unmarshal(msg.Data.Message, &frame); err != nil {
+		c.onError(err)
+		return
+	}
+
+	// Never block the MQTT callback when nobody is waiting anymore
+	select {
+	case c.recordPages <- frame:
+	default:
+	}
+}
