+// parseReplay turns "replay" or "replay-<start>-<end>" (unix seconds) into
+// the offer's replay block.
+func parseReplay(resolution string) (tuya.Replay, bool) {
+	if resolution == "replay" {
+		return tuya.Replay{IsReplay: 1}, true
+	}
+
+	var start, end int64
+	if n, _ := fmt.Sscanf(resolution, "replay-%d-%d", &start, &end); n == 2 && end > start {
+		return tuya.Replay{IsReplay: 1, StartTime: start, EndTime: end}, true
+	}
+
+	return tuya.Replay{}, false
+}
+
+// SDList lists a day's SD-card recordings; the bridge must be a started replay session.
+func (wb *WebRTCBridge) SDList(year, month, day int) ([]tuya.SDRecord, error) {
+	if wb.replay.IsReplay == 0 || wb.cameraClient == nil {
+		return nil, errors.New("not a started replay session")
+	}
+
+	return wb.cameraClient.QueryRecordsByDay(year, month, day)
+}
