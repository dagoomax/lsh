+func runRecordings(cmd *cobra.Command, args []string) error {
+	day, err := time.ParseInLocation("2006-01-02", args[1], time.Local)
+	if err != nil {
+		return fmt.Errorf("invalid date %q, want YYYY-MM-DD", args[1])
+	}
+
+	cameras, err := storageManager.GetAllCameras()
+	if err != nil {
+		return fmt.Errorf("failed to get cameras: %v", err)
+	}
+
+	var targetCamera *storage.CameraInfo
+	for _, cam := range cameras {
+		if cam.DeviceID == args[0] || cam.DeviceName == args[0] {
+			targetCamera = &cam
+			break
+		}
+	}
+
+	if targetCamera == nil {
+		return fmt.Errorf("camera not found: %s", args[0])
+	}
+
+	user, err := getUserFromKey(targetCamera.UserKey)
+	if err != nil {
+		return err
+	}
+
+	bridge := rtsp.NewWebRTCBridge(targetCamera, "replay", user, storageManager)
+	if err := bridge.Start(); err != nil {
+		return fmt.Errorf("failed to open replay session: %v", err)
+	}
+	defer bridge.Stop()
+
+	records, err := bridge.SDList(day.Year(), int(day.Month()), day.Day())
+	if err != nil {
+		return fmt.Errorf("failed to list recordings: %v", err)
+	}
+
+	if asJSON, _ := cmd.Flags().GetBool("json"); asJSON {
+		out, _ := json.Marshal(records)
+		fmt.Println(string(out))
+		return nil
+	}
+
+	fmt.Printf("%d recording(s) on %s:\n", len(records), args[1])
+	for _, r := range records {
+		fmt.Printf("  %s - %s  %s/replay/%d-%d\n",
+			time.Unix(r.StartTime, 0).Format("15:04:05"), time.Unix(r.EndTime, 0).Format("15:04:05"),
+			targetCamera.RTSPPath, r.StartTime, r.EndTime)
+	}
+
+	return nil
+}
